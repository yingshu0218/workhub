{
  "name": "nexus-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "寻鸽工作台 (Nexus Workspace) - 一体化数字工作台",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-icons.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "format": "prettier --write src",
    "check:icons": "node scripts/check-icons.mjs",
    "test": "vitest run",
    "relay": "node relay/index.mjs",
    "relay:stdio": "node relay/index.mjs --stdio",
    "gen:skills": "node scripts/gen-skills.mjs",
    "serve": "node scripts/serve.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@material-symbols/svg-400": "^0.47.1",
    "d3-force": "^3.0.0",
    "dayjs": "^1.11.13",
    "dexie": "^4.0.8",
    "dexie-react-hooks": "^1.1.7",
    "dompurify": "^3.4.15",
    "marked": "^15.0.4",
    "nanoid": "^5.0.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@material-symbols/svg-400": "^0.47.1",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/d3-force": "^3.0.10",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^26.4.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.7",
    "vitest": "^5.0.0"
  }
}
