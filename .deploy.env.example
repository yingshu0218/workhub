# 寻鸽工作台 · 部署配置（gitignore，不入库，勿提交）
# 复制本文件为 .deploy.env 并填写真实值

# SSH 别名或 user@host（沙箱/非交互环境下别名可能解析失败，建议用 user@host 直连 + 显式 key）
DEPLOY_SSH=root@8.153.19.221
# 私钥路径（可选；留空则用 ssh 默认。若 ssh 别名配置了 IdentityFile，这里应填同一把 key）
DEPLOY_SSH_KEY=~/.ssh/id_ed25519

# 服务器上 PocketBase 部署目录
DEPLOY_REMOTE_DIR=/opt/pocketbase

# 部署专用超管（勿使用 admin@nexus.local，禁止改动其密码）
DEPLOY_SUPERUSER=deploy@nexus.local
# ⚠️ 本文件会入库：密码一律用占位符，真实值只写在本机的 .deploy.env（已被 gitignore）
DEPLOY_SUPERUSER_PASSWORD=<在此填入部署超管密码>

# 公网站点地址（用于部署后验证入口 JS；可为空）
DEPLOY_PUBLIC_URL=http://8.153.19.221:9001